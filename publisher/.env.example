# Скопируй в publisher/.env и заполни. Сам .env в git не попадает.

# Токен Instagram API with Instagram Login (живёт 60 дней, продление: refresh-token)
IG_ACCESS_TOKEN=
# ID профессионального аккаунта @veselovpro, узнать командой whoami
IG_USER_ID=17841462108620679

# graph.instagram.com — вход через Instagram (по умолчанию)
# graph.facebook.com  — вход через Facebook, тогда для refresh-token нужны FB_APP_ID и FB_APP_SECRET
IG_HOST=graph.facebook.com
IG_API_VERSION=v27.0
# FB_APP_ID=
# FB_APP_SECRET=

# Telegram: токен бота от @BotFather и канал
TG_BOT_TOKEN=
TG_CHAT_ID=@veselovpro_marketing

# Откуда Instagram забирает слайды: raw (по умолчанию, raw.githubusercontent.com) или jsdelivr
URL_STYLE=raw
# Коммит или ветка со слайдами. Пусто = текущий коммит локального репозитория
CONTENT_REF=
